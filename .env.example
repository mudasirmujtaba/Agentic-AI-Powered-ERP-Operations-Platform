# Secrets for `docker compose up`. Copy to .env (gitignored) and replace every value.
# SQL Server requires 8+ characters with upper, lower, digit and symbol for both SQL passwords.

SA_PASSWORD=Change.Me.Sa1!
AI_READER_PASSWORD=Change.Me.Reader1!

# At least 32 random characters, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SIGNING_KEY=

# Password for admin@opspilot.local and the demo users (manager@, sales@, inventory@, procurement@, finance@).
ADMIN_PASSWORD=Change.Me.Admin1!

# Shared secret between the API and the AI service.
AI_INTERNAL_KEY=

# Groq API key (console.groq.com). Leave empty to run without the AI Copilot.
GROQ_API_KEY=
