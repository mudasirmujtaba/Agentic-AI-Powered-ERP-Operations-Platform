# Copy to .env and fill in. .env is gitignored.

# Groq API key (console.groq.com -> API Keys)
GROQ_API_KEY=

# Model for SQL generation and answers, and a fast model for intent routing.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Shared secret; must match AiService:InternalKey in the OpsPilot.Api user secrets.
INTERNAL_KEY=

# OpsPilot API the agents call with the signed-in user's token.
ERP_API_URL=https://localhost:7170/api
# The local ASP.NET dev certificate is self-signed; keep false for localhost only.
ERP_VERIFY_TLS=false
